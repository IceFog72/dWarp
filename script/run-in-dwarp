#!/usr/bin/env python3
"""Run a command in a visible dWarp tab and mirror its terminal output."""

import argparse
import errno
import json
import os
from pathlib import Path
import select
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time


POLL_SECONDS = 0.05
HEARTBEAT_SECONDS = 15
SCRIPT = Path(__file__).resolve()


def write_json(path, value):
    temporary = path.with_suffix(".tmp")
    with temporary.open("w", encoding="utf-8") as output:
        json.dump(value, output)
    temporary.replace(path)


def private_directory(path):
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError(f"Expected an owned, private directory: {path}")


def terminal_size(fd):
    import fcntl
    import termios
    import struct

    try:
        return fcntl.ioctl(fd, termios.TIOCGWINSZ, bytes(8))
    except OSError:
        return struct.pack("HHHH", 24, 100, 0, 0)


def signal_group(pid, sig):
    try:
        os.killpg(pid, sig)
    except ProcessLookupError:
        pass


def worker(directory):
    import fcntl
    import pty
    import termios
    import tty

    private_directory(directory)
    # Exclusive ownership prevents a duplicate launch from running a task twice.
    lock = os.open(directory / "worker.lock", os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    os.close(lock)
    request = json.loads((directory / "request.json").read_text())
    result = {"state": "failed", "exit_code": 125}
    pid = None
    master = None
    old_terminal = None
    reason = None
    reaped = False

    def interrupted(signum, frame):
        nonlocal reason
        reason = f"signal {signum}"

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, interrupted)

    try:
        if (directory / "cancel").exists() or (
            time.time() - (directory / "heartbeat").stat().st_mtime > HEARTBEAT_SECONDS
        ):
            result = {"state": "cancelled", "exit_code": 130}
            return 130
        print("\ndWarp command: " + json.dumps(request["argv"]), flush=True)
        print("Working directory: " + json.dumps(request["cwd"]), flush=True)
        size = terminal_size(0)
        pid, master = pty.fork()
        if pid == 0:
            try:
                fcntl.ioctl(0, termios.TIOCSWINSZ, size)
                os.chdir(request["cwd"])
                os.execvpe(request["argv"][0], request["argv"], os.environ)
            except (OSError, ValueError) as error:
                os.write(2, f"Cannot execute command: {error}\n".encode())
                os._exit(127)

        (directory / "worker-heartbeat").touch()
        write_json(directory / "started.json", {"pid": os.getpid(), "command_pid": pid})
        fcntl.ioctl(master, termios.TIOCSWINSZ, terminal_size(0))
        if os.isatty(0):
            old_terminal = termios.tcgetattr(0)
            tty.setraw(0)
        os.set_blocking(master, False)
        started = time.monotonic()
        interrupt_at = None
        escalation = 0
        child_status = None
        child_finished = None
        input_open = os.isatty(0)
        input_buffer = bytearray()
        output_closed = False
        heartbeat_at = 0
        previous_size = None
        with (directory / "output.log").open("ab", buffering=0) as log:
            while True:
                now = time.monotonic()
                if now - heartbeat_at >= 1:
                    (directory / "worker-heartbeat").touch()
                    heartbeat_at = now
                if child_status is None:
                    if (directory / "cancel").exists():
                        reason = reason or "cancelled by caller"
                    if time.time() - (directory / "heartbeat").stat().st_mtime > HEARTBEAT_SECONDS:
                        reason = reason or "caller disconnected"
                    if request["timeout"] is not None and now - started >= request["timeout"]:
                        reason = reason or "command timed out"
                    if reason and interrupt_at is None:
                        interrupt_at = now
                        signal_group(pid, signal.SIGINT)
                    if interrupt_at is not None:
                        elapsed = now - interrupt_at
                        if elapsed >= 2 and escalation == 0:
                            signal_group(pid, signal.SIGTERM)
                            escalation = 1
                        if elapsed >= 4 and escalation == 1:
                            signal_group(pid, signal.SIGKILL)
                            escalation = 2
                    finished, status = os.waitpid(pid, os.WNOHANG)
                    if finished:
                        reaped = True
                        child_status = os.waitstatus_to_exitcode(status)
                        child_finished = now

                size = terminal_size(0)
                if size != previous_size:
                    fcntl.ioctl(master, termios.TIOCSWINSZ, size)
                    previous_size = size
                ready, writable, _ = select.select(
                    ([master] if not output_closed else []) + ([0] if input_open else []),
                    [master] if input_buffer else [], [], POLL_SECONDS,
                )
                if 0 in ready:
                    data = os.read(0, 4096)
                    if data:
                        input_buffer.extend(data)
                    else:
                        input_open = False
                if master in writable:
                    try:
                        written = os.write(master, input_buffer)
                        del input_buffer[:written]
                    except OSError as error:
                        if error.errno != errno.EIO:
                            raise
                        input_buffer.clear()
                        input_open = False
                if master in ready:
                    try:
                        data = os.read(master, 65536)
                    except OSError as error:
                        if error.errno != errno.EIO:
                            raise
                        data = b""
                    if data:
                        log.write(data)
                        try:
                            sys.stdout.buffer.write(data)
                            sys.stdout.buffer.flush()
                        except (BrokenPipeError, OSError):
                            reason = reason or "terminal disconnected"
                    else:
                        output_closed = True
                        input_open = False
                        input_buffer.clear()
                # Drain output, but do not wait forever for a background descendant's PTY.
                if child_status is not None and (output_closed or now - child_finished > 1):
                    break
        exit_code = child_status if child_status >= 0 else 128 - child_status
        result = {"state": "finished", "exit_code": exit_code,
                  "command_exit_code": exit_code, "reason": reason}
        if reason:
            result["state"] = "cancelled"
            result["exit_code"] = 124 if reason == "command timed out" else 130
    except BaseException as error:
        result["error"] = str(error)
        if pid is not None and pid > 0 and not reaped:
            try:
                signal_group(pid, signal.SIGKILL)
                os.waitpid(pid, 0)
            except (ProcessLookupError, ChildProcessError):
                pass
    finally:
        if old_terminal is not None:
            try:
                termios.tcsetattr(0, termios.TCSADRAIN, old_terminal)
            except termios.error:
                pass
        if master is not None:
            os.close(master)
        write_json(directory / "result.json", result)
    return result["exit_code"]


def run(args):
    cwd = Path(args.cwd).resolve(strict=True)
    if not cwd.is_dir():
        raise ValueError(f"Working directory is not a directory: {cwd}")
    argv = args.command
    if argv[:1] == ["--"]:
        argv = argv[1:]
    if not argv or not argv[0] or any("\0" in arg for arg in argv):
        raise ValueError("Provide a program and arguments after --")
    if os.sep in argv[0]:
        executable = os.path.abspath(cwd / argv[0])
    else:
        search_path = os.pathsep.join(str(cwd / entry) for entry in os.get_exec_path())
        executable = shutil.which(argv[0], path=search_path)
    if executable is None or not os.path.isfile(executable) or not os.access(executable, os.X_OK):
        raise ValueError(f"Executable not found: {argv[0]}")
    # Preserve executable symlink names: rustup and similar shims dispatch on argv[0].
    argv = [os.path.abspath(executable), *argv[1:]]
    launcher = shutil.which(args.warp)
    if launcher is None:
        raise ValueError(f"dWarp launcher not found: {args.warp}")
    capabilities = subprocess.run([launcher, "--help"], capture_output=True, timeout=5)
    if capabilities.returncode != 0 or b"--no-focus" not in capabilities.stdout:
        raise ValueError("Installed dWarp needs rebuilding for background command launches.")
    if not args.new_tab:
        if not args.group or len(args.group.encode()) > 128 or any(ord(c) < 32 or ord(c) == 127 for c in args.group):
            raise ValueError("Command group must contain 1 to 128 bytes without control characters")
        if capabilities.returncode != 0 or b"--command-group" not in capabilities.stdout:
            raise ValueError("Installed dWarp needs rebuilding for command groups. Use --new-tab explicitly for temporary compatibility.")
    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    root = state / "dwarp/agent-runs"
    root.mkdir(parents=True, mode=0o700, exist_ok=True)
    private_directory(root)
    directory = Path(tempfile.mkdtemp(prefix=time.strftime("%Y%m%d-%H%M%S-"), dir=root))
    write_json(directory / "request.json", {"argv": argv, "cwd": str(cwd), "timeout": args.timeout})
    (directory / "heartbeat").touch()
    print(f"dWarp task: {directory}", file=sys.stderr, flush=True)
    print("Command: " + json.dumps(argv), file=sys.stderr, flush=True)
    interrupted = False

    def cancel(signum, frame):
        nonlocal interrupted
        interrupted = True
        (directory / "cancel").touch()

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, cancel)
    with (directory / "launcher.log").open("ab", buffering=0) as launch_log:
        layout = [] if args.new_tab else ["--command-group", args.group]
        launch = subprocess.Popen(
            [launcher, "--no-focus", "--working-directory", str(cwd), *layout, "--execute",
             sys.executable, str(SCRIPT), "_worker", str(directory)],
            stdin=subprocess.DEVNULL, stdout=launch_log, stderr=launch_log,
            start_new_session=True,
        )
        deadline = time.monotonic() + args.launch_timeout
        offset = 0
        heartbeat_at = 0
        while True:
            if time.monotonic() - heartbeat_at >= 1:
                (directory / "heartbeat").touch()
                heartbeat_at = time.monotonic()
            output = directory / "output.log"
            data = b""
            if output.exists():
                with output.open("rb") as stream:
                    stream.seek(offset)
                    data = stream.read(65536)
                offset += len(data)
                try:
                    sys.stdout.buffer.write(data)
                    sys.stdout.buffer.flush()
                except BrokenPipeError:
                    interrupted = True
                    (directory / "cancel").touch()
            result_file = directory / "result.json"
            if result_file.exists() and (not output.exists() or output.stat().st_size == offset):
                result = json.loads(result_file.read_text())
                print(f"\ndWarp task exited with status {result['exit_code']}. Log: {output}",
                      file=sys.stderr, flush=True)
                if result.get("error"):
                    print(result["error"], file=sys.stderr)
                return result["exit_code"]
            if not (directory / "started.json").exists():
                status = launch.poll()
                if status not in (None, 0) or time.monotonic() >= deadline or interrupted:
                    (directory / "cancel").touch()
                    print(f"dWarp did not start the task. See {directory / 'launcher.log'}",
                          file=sys.stderr)
                    return 130 if interrupted else 125
            elif time.time() - (directory / "worker-heartbeat").stat().st_mtime > HEARTBEAT_SECONDS:
                (directory / "cancel").touch()
                print(f"dWarp worker stopped responding. Logs: {directory}", file=sys.stderr)
                return 125
            if len(data) == 65536:
                continue
            time.sleep(POLL_SECONDS)


def positive_seconds(value):
    number = float(value)
    if not 0 < number < float("inf"):
        raise argparse.ArgumentTypeError("Expected a finite positive duration")
    return number


def main():
    if os.name != "posix":
        raise ValueError("run-in-dwarp requires a POSIX host with PTY support")
    os.umask(0o077)
    if sys.argv[1:2] == ["_worker"]:
        return worker(Path(sys.argv[2]))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cwd", default=os.getcwd())
    parser.add_argument("--warp", default="dwarp", help="dWarp launcher executable")
    layout = parser.add_mutually_exclusive_group()
    layout.add_argument("--group", default=os.environ.get("DWARP_COMMAND_GROUP", "Codex"),
                        help="Dedicated command tab name (default: Codex)")
    layout.add_argument("--new-tab", action="store_true", help="Open a separate background tab instead of reusing a command group")
    parser.add_argument("--timeout", type=positive_seconds, help="Command timeout in seconds")
    parser.add_argument("--launch-timeout", type=positive_seconds, default=30)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    return run(parser.parse_args())


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"run-in-dwarp: {error}", file=sys.stderr)
        sys.exit(125)
