[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=dWarp
GenericName=TerminalEmulator

Exec=dwarp %U
StartupWMClass=dev.warp.dWarp

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.warp.dWarp

Categories=System;TerminalEmulator;
X-TerminalArgExec=--execute
X-TerminalArgDir=--working-directory

# Don't run this application within a terminal.
Terminal=false

# Register the current URL scheme and the legacy alias.
MimeType=x-scheme-handler/dwarp;x-scheme-handler/openwarp;
